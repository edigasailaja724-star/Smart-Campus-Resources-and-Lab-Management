# Server Configuration
PORT=5000
NODE_ENV=development

# Session and Security Secrets
# Generate a strong random key for production
SESSION_SECRET=alits_secure_smart_campus_session_secret_change_in_production_98765
SESSION_MAX_AGE_HOURS=24

# Faculty Authentication (Single Shared Password)
# Default password: "AlitsManagement"
# Generated with bcrypt (cost factor 10)
FACULTY_PASSWORD=AlitsManagement
FACULTY_PASSWORD_HASH=$2a$10$FA/dGpREvzi1gJZJrFgLBeR1uh665q.esxCF.nYQGmIfvFHkqKKBy

# Supabase PostgreSQL & Storage Configuration
# Find these in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Supabase Storage Buckets
STORAGE_BUCKET_MATERIALS=academic-materials
STORAGE_BUCKET_ASSETS=campus-assets

# Optional Official University Update Feeds (Leave blank if not configured)
UNIVERSITY_OFFICIAL_URL=https://jntua.ac.in
OFFICIAL_UPDATE_SOURCE_NAME=JNTUA / University Portal
